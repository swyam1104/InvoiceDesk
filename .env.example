# InvoiceDesk Environment Variables
# Copy this file to .env and customize for your environment.

# Server configuration
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# Database connection:
# - Leave blank or omit DATABASE_URL to use built-in in-memory PostgreSQL (zero config, great for local testing).
# - Provide a standard PostgreSQL URL for live / production databases (e.g. Neon, Supabase, Render Postgres):
# DATABASE_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Session Secret (used to sign Express session cookies):
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=invoicedesk_dev_secret_change_in_production_xyz123

# Node environment (development | production)
NODE_ENV=development

# IMPORTANT: Zero AI SDK keys required!
# InvoiceDesk has NO AI inside the app — all AI runs on the client's own Claude/Cursor via MCP.
